{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "AllowEC2ReadFromUploadsBucket",
      "Effect": "Allow",
      "Action": [
        "s3:GetObject",
        "s3:ListBucket"
      ],
      "Resource": [
        "arn:aws:s3:::icloudems-uploads*",
        "arn:aws:s3:::icloudems-uploads*/*"
      ]
    }
  ]
}
